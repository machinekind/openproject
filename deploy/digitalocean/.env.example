# Copy to .env on the server, chmod 600. provision.sh writes most of this for you.

# Public host name. A DNS A record must point at the Droplet before first start,
# otherwise Caddy cannot obtain a certificate.
OPENPROJECT_HOST__NAME=op.example.org

# Image to run. This fork's built-in MCP server and project setup tools only exist in the fork's image:
# build it with the "Build fork image" workflow and pin the tag it prints. The official image
# (openproject/openproject:<version>-slim) also works with this stack, but answers 404 on /mcp without a licence.
OPENPROJECT_IMAGE=ghcr.io/machinekind/openproject:CHANGE_ME

# openssl rand -hex 64. Keep a copy in your password manager: losing it makes encrypted columns unreadable.
SECRET_KEY_BASE=

# From `doctl databases connection <id> --format URI`, with the database name changed to
# openproject and &pool=12 appended. Use the PRIVATE host name so traffic stays inside the VPC.
DATABASE_URL=postgresql://doadmin:PASSWORD@private-HOST:25060/openproject?sslmode=require&pool=12

# Connection budget. The 1 GiB managed database allows 22 backend connections:
# 2 web workers x 4 threads + 5 job threads + overhead stays below that.
# On the 2 GiB database (47 connections) you can raise MAX__THREADS to 8 and pool to 20.
OPENPROJECT_WEB_WORKERS=2
OPENPROJECT_WEB_MIN__THREADS=2
OPENPROJECT_WEB_MAX__THREADS=4
OPENPROJECT_GOOD__JOB__MAX__THREADS=5

# First seed only.
OPENPROJECT_SEED__ADMIN__USER__PASSWORD=
OPENPROJECT_SEED__ADMIN__USER__PASSWORD__RESET=true
OPENPROJECT_SEED__ADMIN__USER__MAIL=admin@example.org
OPENPROJECT_DEFAULT__LANGUAGE=en

# Outgoing mail. Mail leaves through the worker; verify at /health_checks/mail.
OPENPROJECT_EMAIL__DELIVERY__METHOD=smtp
OPENPROJECT_SMTP__ADDRESS=
OPENPROJECT_SMTP__PORT=587
OPENPROJECT_SMTP__DOMAIN=
OPENPROJECT_SMTP__USER__NAME=
OPENPROJECT_SMTP__PASSWORD=
OPENPROJECT_SMTP__AUTHENTICATION=plain
OPENPROJECT_SMTP__ENABLE__STARTTLS__AUTO=true
OPENPROJECT_MAIL__FROM=openproject@example.org
