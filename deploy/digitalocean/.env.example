# Template for the server's /srv/openproject/.env (mode 600). provision.sh fills in the secrets and
# writes the result to ~/.config/openproject-do/.env, outside the repository.

# Public host name. A DNS A record must point at the Droplet before first start,
# otherwise Caddy cannot obtain a certificate.
OPENPROJECT_HOST__NAME=op.example.org

# Image to run. This fork's built-in MCP server and project setup tools only exist in the fork's image:
# build it with the "Build fork image" workflow and copy the line from its run summary. Keep the
# @sha256 digest: a tag can be overwritten by anyone with write access to the repository, a digest cannot.
# The official image (openproject/openproject:<version>-slim) also works, but answers 404 on /mcp.
OPENPROJECT_IMAGE=ghcr.io/machinekind/openproject:CHANGE_ME@sha256:CHANGE_ME

# openssl rand -hex 64. Keep a copy in your password manager: losing it makes encrypted columns unreadable.
SECRET_KEY_BASE=

# From `doctl databases connection <id> --format URI`, with the database name changed to
# openproject and &pool=12 appended. Use the PRIVATE host name so traffic stays inside the VPC.
DATABASE_URL=postgresql://doadmin:PASSWORD@private-HOST:25060/openproject?sslmode=require&pool=12

# Connection budget. The 1 GiB managed database allows 22 backend connections (25 minus 3 reserved).
# Web: 2 workers x 4 threads + the Puma master = 9. Worker: 3 job threads + 3 utility connections = 6.
# A deploy adds about 2 for the seeder and a backup adds 1, so the worst case is about 18 of 22.
# pool is per process and must be at least the thread count of the largest process.
# On the 2 GiB database (47 connections) you can raise MAX__THREADS to 8, job threads to 5 and pool to 20.
OPENPROJECT_WEB_WORKERS=2
OPENPROJECT_WEB_MIN__THREADS=2
OPENPROJECT_WEB_MAX__THREADS=4
OPENPROJECT_GOOD__JOB__MAX__THREADS=3

# First seed only. Use a mailbox you can read: password recovery mail goes there.
OPENPROJECT_SEED__ADMIN__USER__PASSWORD=
OPENPROJECT_SEED__ADMIN__USER__PASSWORD__RESET=true
OPENPROJECT_SEED__ADMIN__USER__MAIL=admin@example.org
OPENPROJECT_DEFAULT__LANGUAGE=en

# The team is invite-only. 0 disables the public registration form.
OPENPROJECT_SELF__REGISTRATION=0

# Outgoing mail. Mail leaves through the worker. After go-live send a test mail from
# Administration, Emails and notifications.
OPENPROJECT_EMAIL__DELIVERY__METHOD=smtp
OPENPROJECT_SMTP__ADDRESS=
# DigitalOcean blocks outbound SMTP on ports 25, 465 and 587 for most accounts. Most providers also
# listen on 2525; check yours. Test from the Droplet: timeout 5 bash -c '</dev/tcp/SMTP_HOST/2525' && echo open
OPENPROJECT_SMTP__PORT=2525
OPENPROJECT_SMTP__DOMAIN=
OPENPROJECT_SMTP__USER__NAME=
OPENPROJECT_SMTP__PASSWORD=
OPENPROJECT_SMTP__AUTHENTICATION=plain
OPENPROJECT_SMTP__ENABLE__STARTTLS__AUTO=true
OPENPROJECT_MAIL__FROM=openproject@example.org

# Nightly portable backup (backup.sh). Attachments exist only on the Droplet, so set a remote.
# Configure it once with `rclone config` on the Droplet, preferably at a provider other than DigitalOcean.
# RCLONE_REMOTE=offsite:my-bucket/openproject
# BACKUP_DIR=/var/backups/openproject

# Values are used literally. If a value contains a dollar sign, wrap it in single quotes,
# because Docker Compose would otherwise try to expand it.
