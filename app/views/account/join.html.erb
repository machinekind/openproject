<% html_title t("account.invite_link.join_title") %>

<%= render(Primer::Beta::BorderBox.new(test_selector: "join-project-confirmation")) do |box| %>
  <% box.with_header do %>
    <%= render(Primer::Beta::Heading.new(tag: :h2)) { t("account.invite_link.join_title") } %>
  <% end %>
  <% box.with_body do %>
    <%= render(Primer::Beta::Text.new(tag: :p, mt: 0)) do %>
      <%= t(
            "account.invite_link.join_description",
            project: @invite_link.project.name,
            role: @invite_link.role.name
          ) %>
    <% end %>
  <% end %>
  <% box.with_footer do %>
    <%= form_with(
          url: account_join_project_path(token: @invite_link.value),
          method: :post,
          data: { turbo: false, test_selector: "join-project-form" }
        ) do %>
      <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit, test_selector: "join-project-submit")) do %>
        <%= t("account.invite_link.join_button") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
