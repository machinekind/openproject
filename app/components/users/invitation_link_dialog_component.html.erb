<%=
  render(
    Primer::Alpha::Dialog.new(
      id: DIALOG_ID,
      title: t("users.invitation_link.title"),
      size: :medium_portrait
    )
  ) do |dialog|
    dialog.with_body do
      form_with(
        id: FORM_ID,
        url: generate_invitation_link_user_path(@user),
        method: :post,
        data: { turbo: true }
      ) do
        flex_layout do |flex|
          if link_available?
            flex.with_row(mb: 3) do
              render(Primer::Beta::Text.new) { t("users.invitation_link.description", name: @user.name) }
            end
            flex.with_row(mb: 2) do
              render(OpPrimer::CopyToClipboardComponent.new(invitation_url, test_selector: "invitation-link"))
            end
            flex.with_row do
              render(Primer::Beta::Text.new(color: :muted, font_size: :small)) do
                t("users.invitation_link.expires_at", date: expires_at)
              end
            end
          else
            flex.with_row do
              render(Primer::Beta::Text.new) { t("users.invitation_link.no_valid_link") }
            end
          end
        end
      end
    end

    dialog.with_footer(show_divider: true) do
      concat(render(Primer::Beta::Button.new(data: { close_dialog_id: DIALOG_ID })) { t(:button_close) })
      concat(
        render(
          Primer::Beta::Button.new(
            scheme: link_available? ? :default : :primary,
            form: FORM_ID,
            type: :submit,
            test_selector: "generate-invitation-link"
          )
        ) { t("users.invitation_link.generate") }
      )
    end
  end
%>
